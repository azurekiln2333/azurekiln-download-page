# 复制为 .env 后按需修改：cp .env.example .env
# .env 不会被提交（已在 .gitignore 中），内含密钥请勿泄露。

# ===== Compose 部署配置（宿主机侧消费） =====
# 应用镜像；watchtower 按 WATCHTOWER_POLL_INTERVAL 自动拉取更新
APP_IMAGE=ghcr.io/azurekiln2333/azurekiln-download-page:latest
# 默认仅绑定回环地址，由宿主机 nginx/caddy 反代对外；需直连时改为 0.0.0.0
APP_BIND_HOST=127.0.0.1
APP_PORT=3001
# watchtower 轮询间隔（秒）
WATCHTOWER_POLL_INTERVAL=600
COMPOSE_PROJECT_NAME=azurekiln-download-page

# ===== MySQL（宿主机实例，容器经桥接网关访问） =====
# Linux 上 docker-compose.yaml 已配置 host-gateway：
# host.docker.internal 在容器内解析为宿主机 docker0 网关地址
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=azurekiln
DB_PASSWORD=change-me
DB_NAME=azurekiln_download_page
DB_CONNECTION_LIMIT=10

# ===== 业务配置（backend/server.js 读取） =====
ACCESS_TOKEN_SECRET=please-generate-a-random-secret
ACCESS_TOKEN_TTL_SECONDS=3600
ADMIN_IMPORT_TOKEN=
# 容器在反代之后，保留 X-Forwarded-For 解析访客 IP
TRUST_PROXY=1
LEGACY_LINK_BASE_URL=https://azurekiln.cn/link.php
PUBLIC_DOWNLOAD_BASE_URL=https://dl.azurekiln.cn
SHORT_URL_API_URL=https://azurekiln.cn/sl/api.php
SHORT_URL_PUBLIC_PREFIX=https://azurekiln.cn/
SHORT_URL_CUSTOM_PREFIX=dl
